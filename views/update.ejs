<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update post</title>
    <link rel="stylesheet" href="/CSS/style.css">
</head>
<body>
    <div class="container form-container">
        <div class="form-card">
            <h1 class="heading">Edit Post</h1>
            <div class="post-meta">Post ID: <%=post.id%></div>
            <h3 class="username">@<%=post.username%></h3>
            <form action="/posts/<%=post.id%>?_method=PATCH" method="post">
                <div class="form-group">
                    <label for="content">Content</label>
                    <textarea id="content" name="content" class="form-control" required><%=post.content%></textarea>
                </div>
                <div class="actions">
                    <button type="submit" class="btn btn2">Save Changes</button>
                    <a href="/posts" class="btn btn-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>