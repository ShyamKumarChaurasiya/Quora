<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quora/New post</title>
    <link rel="stylesheet" href="/CSS/style.css">
</head>
<body>
    <div class="container form-container">
        <div class="form-card">
            <h1 class="heading">Create a New Post</h1>
            <form action="/posts" method="post">
                <div class="form-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" class="form-control" placeholder="Enter your username" name="username" required>
                </div>
                <div class="form-group">
                    <label for="content">Post Content</label>
                    <textarea id="content" name="content" class="form-control" placeholder="What's on your mind?" required></textarea>
                </div>
                <div class="actions">
                    <button type="submit" class="btn btn1">Publish Post</button>
                    <a href="/posts" class="btn btn-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>