<%- include("includes/head.ejs"); %>
    <body>
        <div class="container">
            <div class="header-container">
                <h1 class="heading">Quora Posts</h1>
                <a href="/posts/new" class="btn">Create New Post</a>
            </div>

            <div class="posts-grid">
                <% for(let post of posts) {%>
                    <div class="post-card">
                        <h3 class="username">@<%=post.username%></h3>
                        <p class="content"><%=post.content%></p>
                        <div class="actions">
                            <a href="/posts/<%=post.id%>" class="btn btn1">View</a>
                            <a href="/posts/<%=post.id%>/edit" class="btn btn2">Edit</a>
                            <form action="/posts/<%=post.id%>?_method=DELETE" method="POST">
                                <button class="btn btn3">Delete</button>
                            </form>
                        </div>
                    </div>
                <%}%>
            </div>
        </div>
    </body>
</html>
